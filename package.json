{
  "name": "nexus-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS Terminal — professional financial research platform (clean-room, original design)",
  "scripts": {
    "dev": "next dev -p 3141",
    "build": "prisma generate && next build",
    "start": "next start -p 3141",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && npm run db:seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "lightweight-charts": "^5.0.3",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.1.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
