# ─── NEXUS Terminal configuration ───────────────────────────────────────────
# Copy to .env and fill in what you need.
# With NEXUS_DATA_MODE=demo the app runs fully offline with seeded sample data.

DATABASE_URL="file:./nexus.db"

# Registration: open (anyone can sign up) or closed (existing users only)
NEXUS_REGISTRATION="closed"

# Data mode: "demo" (default) or "provider".
# provider mode routes each capability to the configured live adapter and
# falls back to LABELED sample data only where no provider is available:
#   quotes:   STOCK/ETF → Robinhood MCP (if ROBINHOOD_MCP_TOKEN_PATH set), else Yahoo · CRYPTO → Coinbase · FX/index/futures → Yahoo
#   bars:     STOCK/ETF → Robinhood (Massive, then Yahoo fallbacks) · CRYPTO → Coinbase · FX/index/futures → Yahoo
#   options:  Robinhood MCP — real chains + published IV/greeks (Yahoo fallback:
#             real chains + IV, greeks via Black-Scholes; labeled SAMPLE fallback when both fail)
#   news:     RSS — Yahoo Finance / CNBC / MarketWatch (no key needed)
#   filings:  SEC EDGAR (no key needed)
#   economy:    FRED — real econ series + release calendar (needs FRED_API_KEY)
#   fundamentals: Yahoo — real statements/earnings/analyst targets (labeled SAMPLE fallback)
#   screener:   real Yahoo quotes; margin/ROE/RSI/IV columns show “—” (no free source)
NEXUS_DATA_MODE="demo"

# Massive (massive.com, Polygon-compatible) — OHLCV aggregate bars
MASSIVE_API_KEY=""

# Robinhood MCP — real-time STOCK/ETF quotes, bars, and options chains (read-only).
# Path to the OAuth token JSON maintained by the /trading overnight-quote-logger
# service; the app only reads the access token, it never refreshes it.
# ROBINHOOD_MCP_TOKEN_PATH="/home/main/trading/.secrets/robinhood_mcp_oauth.json"

# FRED (fred.stlouisfed.org, free key) — economic series + release calendar
FRED_API_KEY=""

# Server-side quote cache TTL in milliseconds (default 15000)
NEXUS_QUOTE_CACHE_MS="15000"
